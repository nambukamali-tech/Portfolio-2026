# Database Connection Configuration
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=nk_portfolio_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD

# JWT Security Credentials (Minimum 32 characters in production)
Jwt__SecretKey=YOUR_SECURE_RANDOM_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS
Jwt__Issuer=PortfolioApi
Jwt__Audience=PortfolioClient
Jwt__ExpirationInHours=24

# Production Initial Admin Credentials Setup
ADMIN_INITIAL_EMAIL=admin@nambukamali.dev
ADMIN_INITIAL_PASSWORD=YOUR_STRONG_PRODUCTION_ADMIN_PASSWORD

# Configured Production Frontend Origin for CORS (comma-separated)
AllowedOrigins=https://nambukamali.dev,https://your-portfolio.vercel.app
